{
  "name": "@hebline.ai/mcp-server",
  "version": "0.5.0",
  "mcpName": "io.github.Hebline/mcp-server",
  "description": "MCP-native API broker — routes agents to the best service at the best price",
  "type": "module",
  "bin": {
    "mcp-server": "dist/index.js",
    "hebline-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --exclude '**/*.integration.test.*'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "api-broker",
    "hebline",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
